{
  "type": "yorubay-author-regex-mod",
  "version": 1,
  "characterId": "baishiyin-oral-fixation",
  "regex_scripts": [
    {
      "scriptName": "白詩音｜狀態面板",
      "findRegex": "<YORUBAY_STATUS>\\s*場景：([^\\n]*)\\n時間：([^\\n]*)\\n模式：([^\\n]*)\\n白詩音：([^\\n]*)\\n口腔依賴：(\\d{1,3})\\n外殼穩定：(\\d{1,3})\\n越界衝動：(\\d{1,3})\\n被發現風險：(\\d{1,3})\\n觀察者：([^\\n]*)\\n進展：([^\\n]*)\\n親密張力：([^\\n]*)\\s*</YORUBAY_STATUS>",
      "flags": "g",
      "replaceString": "<style>\n\n.yb-status{font:inherit;max-width:100%;margin:10px auto;border:1px solid #6f5868;border-radius:16px;overflow:hidden;background:linear-gradient(180deg,#211923,#171318);box-shadow:0 14px 40px #0006}\n.yb-head{padding:14px 16px;background:linear-gradient(135deg,#352636,#221b29);display:flex;justify-content:space-between;gap:12px;align-items:flex-start}\n.yb-kicker{font-size:11px;letter-spacing:.12em;color:#c99a7a}.yb-scene{font-weight:750;margin-top:3px}.yb-time{font-size:12px;color:#d8c9bd;white-space:nowrap}\n.yb-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;padding:12px}\n.yb-box{background:#ffffff08;border:1px solid #ffffff10;border-radius:11px;padding:10px}.yb-box b{display:block;color:#bca8c0;font-size:11px;margin-bottom:4px}.yb-value{font-size:inherit;line-height:1.55}\n.yb-meters{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px;padding:0 12px 12px}.yb-meter{background:#0e0c10;border-radius:10px;padding:9px;text-align:center;border:1px solid #ffffff0e}.yb-meter span{display:block;font-size:10px;color:#aa99aa}.yb-meter strong{font-size:16px;color:#e1b28f}\n.yb-foot{padding:11px 14px;border-top:1px solid #ffffff0d;display:flex;flex-wrap:wrap;gap:8px 14px;font-size:12px;color:#cabfc8}\n@media(max-width:560px){.yb-grid{grid-template-columns:1fr}.yb-meters{grid-template-columns:repeat(2,minmax(0,1fr))}}\n</style>\n<section class=\"yb-status\">\n  <header class=\"yb-head\"><div><div class=\"yb-kicker\">YORUBAY · STATUS</div><div class=\"yb-scene\">$1</div></div><div class=\"yb-time\">$2</div></header>\n  <div class=\"yb-grid\">\n    <div class=\"yb-box\"><b>故事模式</b><div class=\"yb-value\">$3</div></div>\n    <div class=\"yb-box\"><b>白詩音</b><div class=\"yb-value\">$4</div></div>\n    <div class=\"yb-box\"><b>目前觀察者</b><div class=\"yb-value\">$9</div></div>\n    <div class=\"yb-box\"><b>關係進展</b><div class=\"yb-value\">$10</div></div>\n  </div>\n  <div class=\"yb-meters\">\n    <div class=\"yb-meter\"><span>口腔依賴</span><strong>$5</strong></div>\n    <div class=\"yb-meter\"><span>外殼穩定</span><strong>$6</strong></div>\n    <div class=\"yb-meter\"><span>越界衝動</span><strong>$7</strong></div>\n    <div class=\"yb-meter\"><span>被發現風險</span><strong>$8</strong></div>\n  </div>\n  <footer class=\"yb-foot\"><span>親密張力：$11</span><span>只顯示玩家已知／可觀察資訊</span></footer>\n</section>",
      "priority": 60
    }
  ]
}
