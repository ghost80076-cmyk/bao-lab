{
  "version": 1,
  "type": "yorubay-author-regex-mod",
  "scope": "assistant_display",
  "characterId": "midnight-paper-bride-mio",
  "regex_scripts": [
    {
      "scriptName": "雨宮澪｜紙行紀錄",
      "description": "唯讀排版已看見的原文，不執行腳本、不修改狀態。",
      "priority": 70,
      "findRegex": "【YB:MIO:RECORD】\\s*([\\s\\S]*?)\\s*【/YB:MIO:RECORD】",
      "flags": "g",
      "replaceString": "<section aria-label=\"紙行紀錄\" style=\"box-sizing:border-box;max-width:100%;overflow-wrap:anywhere;white-space:pre-wrap;line-height:1.9;padding:20px 18px;margin:16px 0;background:#eee5d3;color:#372e28;border:1px solid #77817a;border-radius:8px\"><small style=\"display:block;font-size:12px;letter-spacing:2px;margin-bottom:12px\">交接簿・原文</small><div>$1</div></section>"
    },
    {
      "scriptName": "雨宮澪｜錄影片段",
      "description": "唯讀排版已看見的原文，不執行腳本、不修改狀態。",
      "priority": 60,
      "findRegex": "【YB:MIO:FRAME】\\s*([\\s\\S]*?)\\s*【/YB:MIO:FRAME】",
      "flags": "g",
      "replaceString": "<section aria-label=\"錄影片段\" style=\"box-sizing:border-box;max-width:100%;overflow-wrap:anywhere;white-space:pre-wrap;line-height:1.9;padding:20px 18px;margin:16px 0;background:#151f22;color:#e4ede6;border:1px solid #77817a;border-radius:8px\"><small style=\"display:block;font-size:12px;letter-spacing:2px;margin-bottom:12px\">影像・可見片段</small><div>$1</div></section>"
    }
  ]
}

