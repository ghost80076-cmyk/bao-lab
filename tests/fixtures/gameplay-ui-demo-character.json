          {
            "type": "meters",
            "title": "當前狀態",
            "items": [
              {
                "label": "血",
                "value_path": "modules.player.hp",
                "max_path": "modules.player.max_hp"
              },
              {
                "label": "氣",
                "value_path": "modules.player.qi",
                "max_path": "modules.player.max_qi"
              }
            ]
          },
          {
            "type": "stats",
            "title": "基礎屬性",
            "items": [
              {
                "label": "力量",
                "path": "modules.player.strength"
              },
              {
                "label": "身法",
                "path": "modules.player.agility"
              },
              {
                "label": "出身",
                "path": "modules.player.origin"
              }
            ]
          }
        ]
      },
      {
        "id": "combat",
        "label": "戰鬥",
        "sections": [
          {
            "type": "actions",
            "title": "戰鬥指令",
            "items": [
              {
                "label": "穩健迎戰",
                "draft": "我採取穩健策略迎戰，優先保命並觀察對手破綻。"
              }
            ]
          }
        ]
      }
    ],
    "theme": {
      "preset": "stage-neon",
      "accent": "#c78cff",
      "density": "compact",
      "radius": "soft",
      "meter": "glow"
    }
