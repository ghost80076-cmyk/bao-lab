        "max_hp": 810,
        "qi": 380,
        "max_qi": 380,
        "strength": 8,
        "agility": 8,
        "origin": "散修"
      }
    }
  },
  "gameplay_ui": {
    "version": 1,
    "builder": {
      "title": "踏入東洲之前",
      "description": "先分配基礎屬性，再選擇出身。",
      "point_pool": 6,
      "attributes": [
        {
          "key": "strength",
          "label": "力量",
          "base": 8,
          "min": 8,
          "max": 14,
          "target_path": "modules.player.strength"
        },
        {
          "key": "agility",
          "label": "身法",
          "base": 8,
          "min": 8,
          "max": 14,
          "target_path": "modules.player.agility"
        }
      ],
      "fields": [
        {
          "key": "origin",
