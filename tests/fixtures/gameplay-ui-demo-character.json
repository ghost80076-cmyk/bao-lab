              {
                "label": "穩健迎戰",
                "draft": "我採取穩健策略迎戰，優先保命並觀察對手破綻。"
              }
            ]
          }
        ]
      },
      {
        "id": "adventure",
        "label": "冒險",
        "sections": [
          {
            "type": "cards",
            "title": "人物圖鑑",
            "path": "npcs",
            "variant": "codex",
            "limit": 8
          },
          {
            "type": "cards",
            "title": "任務",
            "path": "modules.quest_log.quests",
            "variant": "quest",
            "limit": 6
          },
          {
            "type": "cards",
            "title": "隊伍",
            "path": "modules.party.members",
            "variant": "party",
            "limit": 6
          },
          {
            "type": "cards",
            "title": "技能",
            "path": "modules.player.skills",
            "variant": "skill",
            "limit": 8
          }
        ]
      },
      {
        "id": "archive",
        "label": "檔案",
        "sections": [
          {
            "type": "tabs",
            "id": "story_archive",
            "title": "STORY ARCHIVE",
            "default_tab": "live",
            "tabs": [
              {
                "id": "live",
                "label": "即時狀態",
                "sections": [
                  {
                    "type": "location_archive",
                    "title": "LOCATION ARCHIVE",
                    "scene_source": "reading-background",
                    "scene_fit": "contain",
                    "time_path": "time",
                    "location_path": "location",
                    "area_path": "modules.scene.area",
                    "status_path": "modules.scene.status",
                    "destinations_path": "modules.scene.destinations",
                    "limit": 6
                  }
                ]
              },
              {
                "id": "relation",
                "label": "關係狀態",
                "sections": [
                  {
                    "type": "stats",
                    "title": "關係",
                    "items": [
                      {
                        "label": "目前關係",
                        "path": "modules.relationship.status"
                      }
                    ]
                  }
                ]
              },
              {
                "id": "changes",
                "label": "本輪變動",
                "sections": [
                  {
                    "type": "timeline",
                    "mode": "round_diff",
                    "title": "本輪變動",
                    "items": [
                      {
                        "label": "地點",
                        "path": "location"
                      },
                      {
                        "label": "關係",
                        "path": "modules.relationship.status"
                      }
                    ]
                  }
                ]
              },
              {
                "id": "history",
                "label": "完整歷程",
                "sections": [
                  {
                    "type": "timeline",
                    "mode": "history",
                    "title": "完整歷程",
                    "path": "modules.history.events",
                    "limit": 12
                  }
                ]
              }
            ]
          }
        ]
      }
    ],
