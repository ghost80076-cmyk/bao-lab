{
  "name": "bao-lab-credits-pilot",
  "main": "worker.js",
  "compatibility_date": "2026-09-21",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://ghost80076-cmyk.github.io",
    "OPENROUTER_MODEL": "replace-with-reviewed-model",
    "GEMINI_MODEL": "replace-with-reviewed-model",
    "ENABLE_GEMINI": "false",
    "DAILY_CALL_LIMIT": "200"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bao-lab-credits-pilot",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ]
}
